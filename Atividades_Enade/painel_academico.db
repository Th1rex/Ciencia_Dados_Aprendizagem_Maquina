-- DESAFIO | Painel Acadêmico de Matrículas (SQL Server / T-SQL)
-- Entidades: ALUNO e TURMA | Relacionamento N:N: MATRICULA



-- DESAFIO | Painel Acadêmico de Matrículas
-- Entidades: ALUNO e TURMA e Relacionamento N:N: MATRICULA

-- Criando  o painel academico 
CREATE DATABASE PAINEL_ACADEMICO;
USE PAINEL_ACADEMICO;
 
 
-- Criando a tabela Curso
CREATE TABLE CURSO
(  co_curso     INTEGER       NOT NULL,
   nome         VARCHAR(100)  NOT NULL,
   CONSTRAINT PK_CURSO PRIMARY KEY (co_curso)
);

-- Criando as tabelas Aluno e Turma
CREATE TABLE ALUNO
(  co_aluno       INTEGER       NOT NULL,
   dt_nascimento  DATE          NULL,
   sg_sexo        CHAR(1)       NULL,
   nome           VARCHAR(100)  NOT NULL,
   CONSTRAINT PK_ALUNO PRIMARY KEY (co_aluno)
);

CREATE TABLE TURMA
(  co_turma     CHAR(11)     NOT NULL,
   co_curso     INTEGER      NOT NULL,  -- coluna que faltava para a FK
   ano          CHAR(4)      NOT NULL,
   periodo      CHAR(1)      NOT NULL,
   descricao    VARCHAR(50)  NULL,
   dt_inicial   DATE         NULL,
   dt_final     DATE         NULL,
   nu_vagas     INTEGER      NOT NULL,  -- DENOMINADOR do indicador
 
   CONSTRAINT PK_TURMA         PRIMARY KEY (co_turma),
   CONSTRAINT FK_TURMA_CURSO   FOREIGN KEY (co_curso) REFERENCES CURSO (co_curso),
   CONSTRAINT CK_TURMA_PERIODO CHECK (periodo IN ('1', '2')),
   CONSTRAINT CK_TURMA_VAGAS   CHECK (nu_vagas > 0),            -- impede denominador zero
   CONSTRAINT CK_TURMA_DATAS   CHECK (dt_final >= dt_inicial)   -- fim não pode vir antes do início
);
 
-- Fazendo o relacionamento de muitos alunos para uma Turma
CREATE TABLE MATRICULA
(  co_aluno      INTEGER   NOT NULL,
   co_turma      CHAR(11)  NOT NULL,
   dt_matricula  DATE      NOT NULL,
   st_matricula  CHAR(1)   NOT NULL,  -- A = ativa, C = cancelada
 
-- Adicionando a regra de duplicidade, por ser chave composta impede que o 
-- aluno apareça duas vezes na mesma turma. 
   CONSTRAINT PK_MATRICULA        PRIMARY KEY (co_aluno, co_turma),
   CONSTRAINT FK_MATRICULA_ALUNO  FOREIGN KEY (co_aluno) REFERENCES ALUNO (co_aluno),
   CONSTRAINT FK_MATRICULA_TURMA  FOREIGN KEY (co_turma) REFERENCES TURMA (co_turma),
   CONSTRAINT CK_MATRICULA_STATUS CHECK (st_matricula IN ('A', 'C'))
);
 
 
