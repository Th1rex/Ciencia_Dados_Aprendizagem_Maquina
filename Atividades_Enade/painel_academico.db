-- 3) INDICADOR: taxa de ocupação de vagas (%)
--    numerador   = matrículas ATIVAS na turma
--    denominador = vagas ofertadas (nu_vagas)

SELECT t.co_turma,
       t.descricao,
       t.ano,
       t.periodo,
       COUNT(m.co_aluno)  AS matriculados,
       t.nu_vagas         AS vagas,
       CAST(100.0 * COUNT(m.co_aluno) / NULLIF(t.nu_vagas, 0)
            AS DECIMAL(5, 1)) AS ocupacao_pct
FROM TURMA t
-- LEFT JOIN: turma sem nenhum aluno aparece com 0% em vez de sumir
LEFT JOIN MATRICULA m
       ON m.co_turma = t.co_turma
      AND m.st_matricula = 'A'
GROUP BY t.co_turma, t.descricao, t.ano, t.periodo, t.nu_vagas
ORDER BY ocupacao_pct DESC;
 
 
-- 4) PREVENÇÃO DE ERRO (apoio à interface)
--    Alimenta a lista de turmas na tela de matrícula do aluno 1:
--    só mostra turmas com vaga e onde ele ainda NÃO está matriculado.
--    (troque o 1 pelo código do aluno selecionado na tela)

SELECT t.co_turma,
       t.descricao,
       t.nu_vagas - COUNT(m.co_aluno) AS vagas_restantes
FROM TURMA t
LEFT JOIN MATRICULA m
       ON m.co_turma = t.co_turma
      AND m.st_matricula = 'A'
WHERE NOT EXISTS (SELECT 1
                  FROM MATRICULA x
                  WHERE x.co_aluno = 1
                    AND x.co_turma = t.co_turma
                    AND x.st_matricula = 'A')
GROUP BY t.co_turma, t.descricao, t.nu_vagas
HAVING COUNT(m.co_aluno) < t.nu_vagas;
 
 
-- 5) TESTE DA REGRA DE DUPLICIDADE
 
-- CT02: mesmo aluno em OUTRA turma -> esperado: ACEITO
INSERT INTO MATRICULA (co_aluno, co_turma, dt_matricula, st_matricula)
VALUES (1, 'SI-2026-2-C', '2026-08-01', 'A');
 
-- CT03: OUTRO aluno na mesma turma -> esperado: ACEITO
INSERT INTO MATRICULA (co_aluno, co_turma, dt_matricula, st_matricula)
VALUES (5, 'SI-2026-2-B', '2026-08-01', 'A');
 
-- CT04: rematrícula após cancelamento -> esperado: ACEITO
-- (a matrícula existente é reativada, sem criar linha duplicada)
UPDATE MATRICULA
SET st_matricula = 'A',
    dt_matricula = '2026-08-01'
WHERE co_aluno = 3
  AND co_turma = 'SI-2026-2-B';
 
-- CT01: aluno 1 já está na turma A -> esperado: ERRO de chave primária
-- (o erro aqui é o resultado CORRETO do teste)
INSERT INTO MATRICULA (co_aluno, co_turma, dt_matricula, st_matricula)
VALUES (1, 'SI-2026-2-A', '2026-08-01', 'A');
 
-- CT01 (verificação): esperado: total = 1
-- Se a ferramenta parar no erro acima, execute este SELECT sozinho.
SELECT COUNT(*) AS total
FROM MATRICULA
WHERE co_aluno = 1
  AND co_turma = 'SI-2026-2-A';
 
