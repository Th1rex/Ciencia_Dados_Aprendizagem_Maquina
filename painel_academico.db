-- =====================================================================
-- DESAFIO | Painel Acadêmico de Matrículas (SQL Server / T-SQL)
-- Entidades: ALUNO e TURMA | Relacionamento N:N: MATRICULA
-- =====================================================================


-- ---------------------------------------------------------------------
-- 1) Criação do banco (mesmo nome no CREATE e no USE)
-- ---------------------------------------------------------------------
IF DB_ID('PAINEL_ACADEMICO') IS NULL
    CREATE DATABASE PAINEL_ACADEMICO;
GO

USE PAINEL_ACADEMICO;
GO


-- ---------------------------------------------------------------------
-- 2) Tabelas
-- ---------------------------------------------------------------------

-- Tabela de apoio: a TURMA original já apontava para CURSO,
-- então ela precisa existir ANTES da TURMA
CREATE TABLE CURSO
(  co_curso     int           NOT NULL,
   nome         varchar(100)  NOT NULL,
   CONSTRAINT PK_CURSO PRIMARY KEY (co_curso)
);
GO

-- ENTIDADE 1: ALUNO
CREATE TABLE ALUNO
(  co_aluno       int           NOT NULL,
   dt_nascimento  date          NULL,      -- date basta, hora não importa
   sg_sexo        char(1)       NULL,
   nome           varchar(100)  NOT NULL,  -- 20 caracteres era curto demais
   CONSTRAINT PK_ALUNO PRIMARY KEY (co_aluno)
);
GO

-- ENTIDADE 2: TURMA
CREATE TABLE TURMA
(  co_turma     char(11)     NOT NULL,
   co_curso     int          NOT NULL,  -- coluna que faltava para a FK
   ano          char(4)      NOT NULL,
   periodo      char(1)      NOT NULL,
   descricao    varchar(50)  NULL,      -- varchar não completa com espaços
   dt_inicial   date         NULL,
   dt_final     date         NULL,
   nu_vagas     int          NOT NULL,  -- DENOMINADOR do indicador

   CONSTRAINT PK_TURMA         PRIMARY KEY (co_turma),
   CONSTRAINT FK_TURMA_CURSO   FOREIGN KEY (co_curso) REFERENCES CURSO(co_curso),
   CONSTRAINT CK_TURMA_PERIODO CHECK (periodo IN ('1', '2')),
   CONSTRAINT CK_TURMA_VAGAS   CHECK (nu_vagas > 0),            -- impede denominador zero
   CONSTRAINT CK_TURMA_DATAS   CHECK (dt_final >= dt_inicial)   -- fim não pode vir antes do início
);
GO

-- RELACIONAMENTO N:N: ALUNO "matricula-se em" TURMA
CREATE TABLE MATRICULA
(  co_matricula  int IDENTITY(1,1)  NOT NULL,
   co_aluno      int                NOT NULL,
   co_turma      char(11)           NOT NULL,
   dt_matricula  datetime           NOT NULL CONSTRAINT DF_MATRICULA_DATA   DEFAULT GETDATE(),
   st_matricula  char(1)            NOT NULL CONSTRAINT DF_MATRICULA_STATUS DEFAULT 'A',  -- A = ativa, C = cancelada

   CONSTRAINT PK_MATRICULA        PRIMARY KEY (co_matricula),
   CONSTRAINT FK_MATRICULA_ALUNO  FOREIGN KEY (co_aluno) REFERENCES ALUNO(co_aluno),
   CONSTRAINT FK_MATRICULA_TURMA  FOREIGN KEY (co_turma) REFERENCES TURMA(co_turma),
   CONSTRAINT CK_MATRICULA_STATUS CHECK (st_matricula IN ('A', 'C'))
);
GO

-- REGRA DE DUPLICIDADE:
-- o mesmo aluno não pode ter duas matrículas ATIVAS na mesma turma.
-- Índice único filtrado: permite rematrícula depois de um cancelamento.
CREATE UNIQUE INDEX UX_MATRICULA_ATIVA
    ON MATRICULA (co_aluno, co_turma)
    WHERE st_matricula = 'A';
GO


-- ---------------------------------------------------------------------
-- 3) Dados de exemplo
-- ---------------------------------------------------------------------
