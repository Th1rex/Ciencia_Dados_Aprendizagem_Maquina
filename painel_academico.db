(5, 'SI-2026-2-C', 'A');
GO


-- ---------------------------------------------------------------------
-- 4) INDICADOR: taxa de ocupação de vagas (%)
--    numerador   = matrículas ATIVAS na turma
--    denominador = vagas ofertadas (nu_vagas)
-- ---------------------------------------------------------------------
CREATE VIEW VW_OCUPACAO_TURMA
AS
SELECT t.co_turma,
       t.descricao,
       t.ano + '/' + t.periodo   AS semestre,
       COUNT(m.co_matricula)     AS matriculados,
       t.nu_vagas                AS vagas,
       CAST(100.0 * COUNT(m.co_matricula) / NULLIF(t.nu_vagas, 0)
            AS decimal(5, 1))    AS ocupacao_pct
FROM TURMA t
-- LEFT JOIN: turma sem nenhum aluno aparece com 0% em vez de sumir
LEFT JOIN MATRICULA m
       ON m.co_turma = t.co_turma
      AND m.st_matricula = 'A'
GROUP BY t.co_turma, t.descricao, t.ano, t.periodo, t.nu_vagas;
GO

-- Painel: ocupação de todas as turmas
SELECT * FROM VW_OCUPACAO_TURMA ORDER BY ocupacao_pct DESC;
GO


-- ---------------------------------------------------------------------
-- 5) PREVENÇÃO DE ERRO (apoio à interface)
--    Consulta que alimenta a lista de turmas na tela de matrícula:
--    só mostra turmas com vaga e onde o aluno ainda NÃO está matriculado.
-- ---------------------------------------------------------------------
DECLARE @co_aluno int = 1;

SELECT v.co_turma,
       v.descricao,
       v.vagas - v.matriculados AS vagas_restantes
FROM VW_OCUPACAO_TURMA v
WHERE v.matriculados < v.vagas
  AND NOT EXISTS (SELECT 1
                  FROM MATRICULA m
                  WHERE m.co_aluno = @co_aluno
                    AND m.co_turma = v.co_turma
                    AND m.st_matricula = 'A');
GO


-- ---------------------------------------------------------------------
-- 6) TESTE DA REGRA DE DUPLICIDADE
--    Roda dentro de uma transação e desfaz tudo no final,
--    para não sujar os dados de exemplo.
-- ---------------------------------------------------------------------
SET XACT_ABORT OFF;  -- erro de unicidade não derruba a transação inteira
BEGIN TRANSACTION;

-- CT01: aluno 1 já está ativo na turma A -> deve ser BLOQUEADO
BEGIN TRY
    INSERT INTO MATRICULA (co_aluno, co_turma) VALUES (1, 'SI-2026-2-A');
    PRINT 'CT01 FALHOU: a duplicata foi aceita';
END TRY
BEGIN CATCH
    IF ERROR_NUMBER() IN (2601, 2627)  -- violação de índice/restrição única
        PRINT 'CT01 PASSOU: duplicata bloqueada pelo banco';
    ELSE
        PRINT 'CT01 FALHOU: erro inesperado - ' + ERROR_MESSAGE();
END CATCH;

-- CT01 (verificação): continua existindo só 1 matrícula ativa
IF (SELECT COUNT(*) FROM MATRICULA
    WHERE co_aluno = 1 AND co_turma = 'SI-2026-2-A' AND st_matricula = 'A') = 1
    PRINT 'CT01 PASSOU: contagem continua 1';
ELSE
    PRINT 'CT01 FALHOU: contagem diferente de 1';

-- CT02: mesmo aluno em OUTRA turma -> deve ser ACEITO
BEGIN TRY
    INSERT INTO MATRICULA (co_aluno, co_turma) VALUES (1, 'SI-2026-2-C');
    PRINT 'CT02 PASSOU: mesmo aluno em outra turma foi aceito';
END TRY
BEGIN CATCH
    PRINT 'CT02 FALHOU: ' + ERROR_MESSAGE();
END CATCH;

-- CT03: OUTRO aluno na mesma turma -> deve ser ACEITO
BEGIN TRY
    INSERT INTO MATRICULA (co_aluno, co_turma) VALUES (5, 'SI-2026-2-B');
    PRINT 'CT03 PASSOU: outro aluno na mesma turma foi aceito';
END TRY
BEGIN CATCH
    PRINT 'CT03 FALHOU: ' + ERROR_MESSAGE();
END CATCH;

-- CT04: aluno 3 tem matrícula CANCELADA na turma B -> rematrícula deve ser ACEITA
BEGIN TRY
    INSERT INTO MATRICULA (co_aluno, co_turma) VALUES (3, 'SI-2026-2-B');
    PRINT 'CT04 PASSOU: rematrícula após cancelamento foi aceita';
END TRY
BEGIN CATCH
    PRINT 'CT04 FALHOU: ' + ERROR_MESSAGE();
END CATCH;

ROLLBACK TRANSACTION;  -- desfaz os inserts dos testes
PRINT 'Testes finalizados (dados de teste desfeitos).';
GO

